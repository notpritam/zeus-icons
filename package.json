{
  "name": "zeus-icons-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:browser && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "sync": "node scripts/sync-catalog.mjs",
    "review:pro:snapshot": "node scripts/snapshot-pro-review.mjs",
    "audit": "node scripts/audit-catalog.mjs",
    "audit:served": "node scripts/audit-served.mjs",
    "test:e2e": "playwright test",
    "audit:tamper": "node scripts/test-catalog-audit.mjs",
    "audit:exports": "node scripts/audit-exports.mjs",
    "trace:pro": "node scripts/trace-pro-batch.mjs",
    "audit:traces": "node scripts/audit-traces.mjs",
    "test:geometry": "node scripts/test-trace-geometry.mjs",
    "test:reconstruction": "node --test scripts/test-reconstruction.mjs",
    "setup:vectorizer": "node scripts/setup-vectorizer.mjs",
    "snapshot:pro:all": "node scripts/snapshot-pro-catalog.mjs",
    "trace:all": "node scripts/trace-pro-batch.mjs .cache/pro-catalog/catalog.json --publish",
    "build:packages": "node scripts/build-packages.mjs",
    "audit:packages": "node scripts/audit-packages.mjs",
    "test:components": "node scripts/test-components.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "build:browser": "node scripts/build-browser-catalog.mjs",
    "build:site": "node scripts/build-site.mjs",
    "postinstall": "node scripts/restore-artwork.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "canvaskit-wasm": "^0.42.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cheerio": "^1.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
